<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Tema principal - Modo claro (automático según el sistema) -->
    <style name="Theme.Arelove" parent="Theme.Material3.Light.NoActionBar">

        <!-- Color principal de la marca -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container</item>

        <!-- Color secundario -->
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/on_secondary</item>
        <item name="colorSecondaryContainer">@color/secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/on_secondary_container</item>

        <!-- Fondo y superficies -->
        <item name="android:colorBackground">@color/background</item>
        <item name="colorOnBackground">@color/on_background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>

        <!-- Errores y bordes -->
        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/on_error</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/outline_variant</item>

        <!-- Barras del sistema -->
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>

        <!-- Fondo de la ventana (evita destello blanco al abrir la app) -->
        <item name="android:windowBackground">@color/background</item>

        <!-- Tipografía global: Poppins -->
        <item name="android:fontFamily">@font/poppins</item>
        <item name="fontFamily">@font/poppins</item>

        <!-- Estilos por defecto del sistema de diseño Arelove -->
        <item name="materialButtonStyle">@style/Widget.Arelove.Button.Primary</item>
        <item name="textInputStyle">@style/Widget.Arelove.TextInput</item>
        <item name="chipStyle">@style/Widget.Arelove.Chip</item>
        <item name="cardViewStyle">@style/Widget.Arelove.Card</item>

        <!-- BottomNavigationView -->
        <item name="bottomNavigationStyle">@style/Widget.Arelove.BottomNavigationView</item>

        <item name="android:windowActionModeOverlay">true</item>

    </style>

    <!-- BottomNavigationView personalizado -->
    <style name="Widget.Arelove.BottomNavigationView" parent="Widget.Material3.BottomNavigationView">
        <item name="itemTextAppearanceActive">@style/Widget.Arelove.BottomNavigationView.Text</item>
        <item name="itemTextAppearanceInactive">@style/Widget.Arelove.BottomNavigationView.Text</item>
        <item name="itemIconSize">24dp</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="itemPaddingTop">8dp</item>
        <item name="itemPaddingBottom">8dp</item>
    </style>

    <style name="Widget.Arelove.BottomNavigationView.Text" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">@font/poppins_medium</item>
    </style>

</resources>

</resources>
