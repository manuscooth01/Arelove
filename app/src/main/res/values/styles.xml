<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ================================================================== -->
    <!--  SISTEMA DE DISEÑO DE ARELOVE - COMPONENTES REUTILIZABLES          -->
    <!--  Se aplican solos vía Theme.Arelove (materialButtonStyle,          -->
    <!--  textInputStyle, chipStyle, cardViewStyle) o con style=/           -->
    <!--  textAppearance= en cada layout.                                   -->
    <!-- ================================================================== -->

    <!-- BOTONES -->

    <!-- Botón principal: relleno rojo -->
    <style name="Widget.Arelove.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:layout_height">56dp</item>
        <item name="cornerRadius">28dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0.03</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Botón con borde (secundario) -->
    <style name="Widget.Arelove.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_height">56dp</item>
        <item name="cornerRadius">28dp</item>
        <item name="strokeWidth">1.5dp</item>
    </style>

    <!-- Botón de texto: sin fondo -->
    <style name="Widget.Arelove.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="cornerRadius">20dp</item>
    </style>

    <!-- CAMPOS DE TEXTO -->

    <!-- Campo de texto con borde y esquinas redondeadas -->
    <style name="Widget.Arelove.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="boxStrokeColor">@color/selector_input_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
    </style>

    <!-- TARJETAS -->

    <!-- Tarjeta plana con borde fino -->
    <style name="Widget.Arelove.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/outline</item>
    </style>

    <!-- Tarjeta de opción del perfil: fondo fijo oscuro y esquinas 20dp.
         El degradado se pinta en ProfileFragment.aplicarFondoDegradado()
         (MaterialCardView ignora android:background al inflar); si ese
         degradado no llega a aplicarse queda este color plano con borde. -->
    <style name="Widget.Arelove.ProfileCard" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/profile_option_bg</item>
        <item name="strokeColor">@color/profile_option_stroke</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- CHIPS -->

    <!-- Chip filtrable -->
    <style name="Widget.Arelove.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipCornerRadius">20dp</item>
        <item name="chipStrokeWidth">1.5dp</item>
    </style>

    <!-- Chip pequeño para intereses en card de swipe -->
    <style name="Widget.Arelove.Chip.Small" parent="Widget.Material3.Chip.Filter">
        <item name="chipCornerRadius">16dp</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="chipMinHeight">28dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
    </style>

    <!-- TIPOGRAFÍA -->

    <!-- Título de pantalla (24sp, bold, tracking cerrado) -->
    <style name="Widget.Arelove.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:lineHeight">29sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Subtítulo de pantalla (14sp, tracking abierto) -->
    <style name="Widget.Arelove.Subtitle" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- Avatar circular -->
    <style name="ShapeAppearance.Arelove.Avatar" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Foto cuadrada con esquinas de 8dp (selfie y foto de perfil
         del panel de administración) -->
    <style name="ShapeAppearance.Arelove.Photo" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>

    <!-- Wordmark "Arelove" con tracking aireado -->
    <style name="Widget.Arelove.Wordmark" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="android:textColor">@color/primary</item>
    </style>

</resources>
