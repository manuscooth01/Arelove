<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ================================================================== -->
    <!--  SISTEMA DE DISEÑO DE ARELOVE - COMPONENTES REUTILIZABLES          -->
    <!--  Se aplican solos vía Theme.Arelove (materialButtonStyle,          -->
    <!--  textInputStyle, chipStyle, cardViewStyle) o con style=/           -->
    <!--  textAppearance= en cada layout.                                   -->
    <!-- ================================================================== -->

    <!-- BOTONES -->

    <!-- Botón principal: relleno rojo -->
    <style name="Widget.Arelove.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:layout_height">56dp</item>
        <item name="cornerRadius">28dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
    </style>

    <!-- Botón con borde (secundario) -->
    <style name="Widget.Arelove.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_height">56dp</item>
        <item name="cornerRadius">28dp</item>
        <item name="strokeWidth">1.5dp</item>
    </style>

    <!-- Botón de texto: sin fondo -->
    <style name="Widget.Arelove.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="cornerRadius">20dp</item>
    </style>

    <!-- CAMPOS DE TEXTO -->

    <!-- Campo de texto con borde y esquinas redondeadas -->
    <style name="Widget.Arelove.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
    </style>

    <!-- TARJETAS -->

    <!-- Tarjeta plana con borde fino -->
    <style name="Widget.Arelove.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/outline</item>
    </style>

    <!-- CHIPS -->

    <!-- Chip filtrable -->
    <style name="Widget.Arelove.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipCornerRadius">20dp</item>
        <item name="chipStrokeWidth">1.5dp</item>
    </style>

    <!-- TIPOGRAFÍA -->

    <!-- Título de pantalla (26sp, bold) -->
    <style name="Widget.Arelove.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Subtítulo de pantalla (15sp) -->
    <style name="Widget.Arelove.Subtitle" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

</resources>
