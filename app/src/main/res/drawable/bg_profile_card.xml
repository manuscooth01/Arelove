<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo de las tarjetas de opción del perfil: degradado sutil sobre el
     fondo siempre oscuro. Sin borde propio: el borde de 1dp lo dibuja
     MaterialCardView (estilo Widget.Arelove.ProfileCard) sobre el
     primer plano, y así no se pinta dos veces. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="0"
        android:endColor="@color/profile_option_bg_end"
        android:startColor="@color/profile_option_bg" />
    <corners android:radius="20dp" />
</shape>
