<?xml version="1.0" encoding="utf-8"?>
<!-- Disco de 32dp detras del icono de cada tarjeta del perfil.
     Base blanca al 15% + borde blanco de 0.5dp: la tarjeta lo tiñe con
     android:backgroundTint, asi el relleno sale como un tinte sutil del
     color del icono y el borde queda en ese mismo color a opacidad plena
     (el modo SRC_IN conserva el alpha de cada trazo por separado).
     Radio 50% sobre un contenedor cuadrado = circulo perfecto. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="#26FFFFFF" />
    <stroke
        android:width="0.5dp"
        android:color="#FFFFFF" />
</shape>
