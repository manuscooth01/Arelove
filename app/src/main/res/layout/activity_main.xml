<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootWelcome"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="32dp"
    android:paddingBottom="32dp">

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Logo placeholder (corazón con letras A y L) -->
    <ImageView
        android:id="@+id/imageLogo"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:contentDescription="@string/logo_description"
        android:src="@drawable/ic_logo_heart" />

    <TextView
        android:id="@+id/textAppName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/poppins_semibold"
        android:text="@string/app_name"
        android:textAppearance="@style/Widget.Arelove.Title" />

    <TextView
        android:id="@+id/textSlogan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/app_slogan"
        android:textAppearance="@style/Widget.Arelove.Subtitle" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Botón principal -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonLogin"
        style="@style/Widget.Arelove.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/poppins_semibold"
        android:text="@string/btn_iniciar_sesion"
        android:textAllCaps="false" />

    <!-- Botón secundario -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonRegister"
        style="@style/Widget.Arelove.Button.Outlined"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/poppins_semibold"
        android:letterSpacing="0.02"
        android:text="@string/btn_registrarse"
        android:textAllCaps="false"
        android:textColor="@color/primary"
        android:textSize="16sp"
        app:strokeColor="@color/primary"
        app:strokeWidth="1.5dp" />

    <TextView
        android:id="@+id/textTerms"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:lineSpacingExtra="2dp"
        android:text="@string/terminos_y_condiciones"
        android:textColor="@color/on_surface_variant"
        android:textSize="12sp" />

</LinearLayout>
