<?xml version="1.0" encoding="utf-8"?>
<!--
    Pantalla de Editar perfil (en construcción).
    Header con botón cerrar + título y aviso de próximamente.
    Mismo patrón que activity_settings.xml: fondo siempre oscuro y
    colores profile_on_dark* fijos en ambos modos.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_canvas_gradient"
    android:orientation="vertical">

    <!-- Header: botón X + título -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <ImageButton
            android:id="@+id/btnCloseEditProfile"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/legal_close"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_close"
            android:tint="@color/profile_on_dark" />

        <TextView
            android:id="@+id/tvEditProfileTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:fontFamily="@font/poppins_semibold"
            android:text="@string/edit_profile"
            android:textColor="@color/profile_on_dark"
            android:textSize="18sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/profile_option_stroke" />

    <!-- Aviso de construcción -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:paddingBottom="48dp">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_icon_circle"
            android:contentDescription="@string/edit_profile"
            android:padding="14dp"
            android:src="@drawable/ic_edit"
            android:tint="@color/primary" />

        <TextView
            android:id="@+id/tvEditProfilePlaceholder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/poppins_medium"
            android:gravity="center"
            android:text="@string/edit_profile_placeholder"
            android:textColor="@color/profile_on_dark_muted"
            android:textSize="15sp"
            tools:text="En construcción." />
    </LinearLayout>

</LinearLayout>
