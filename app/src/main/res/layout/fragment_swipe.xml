<?xml version="1.0" encoding="utf-8"?>
<!--
    Fragment de descubrimiento (swipe).
    Muestra una tarjeta con fotos (ViewPager2), info del perfil y botones like/nope.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <!-- Tarjeta de perfil -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardProfile"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="4dp"
        app:layout_constraintBottom_toTopOf="@+id/btnDislike"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- ViewPager2 para las fotos -->
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/photoPager"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Indicador de página (puntitos) -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/photoIndicator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginTop="12dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:tabBackground="@drawable/selector_photo_indicator"
            app:tabGravity="center"
            app:tabIndicatorHeight="0dp"
            app:tabMinWidth="8dp"
            app:tabMaxWidth="8dp" />

        <!-- Gradiente inferior con info del perfil -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_profile_gradient_bottom">

                <!-- Nombre, edad e ícono verificado -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/poppins_semibold"
                        android:textColor="@android:color/white"
                        android:textSize="24sp"
                        tools:text="María, 25" />

                    <ImageView
                        android:id="@+id/ivVerified"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="8dp"
                        android:contentDescription="@string/profile_verified"
                        android:src="@drawable/ic_verified"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- Ubicación -->
                <TextView
                    android:id="@+id/tvLocation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="8dp"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    tools:text="Caracas, Venezuela" />

                <!-- Bio -->
                <TextView
                    android:id="@+id/tvBio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="16dp"
                    android:maxLines="3"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    tools:text="Me gusta la música, viajar y comer rico 🍕" />

            </LinearLayout>
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Botón Dislike (X) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDislike"
        style="@style/Widget.Arelove.Button.Outlined"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginEnd="24dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:padding="0dp"
        android:text="@string/swipe_nope"
        android:textSize="0sp"
        app:icon="@drawable/ic_dislike"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:iconSize="28dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btnLike"
        app:strokeColor="@color/heart_red"
        app:strokeWidth="2dp" />

    <!-- Botón Like (♥) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLike"
        style="@style/Widget.Arelove.Button.Primary"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginStart="24dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:padding="0dp"
        android:text="@string/swipe_like"
        android:textSize="0sp"
        app:icon="@drawable/ic_like"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:iconSize="28dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/btnDislike"
        app:backgroundTint="@color/heart_red" />

    <!-- ProgressBar de carga -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Estado vacío -->
    <TextView
        android:id="@+id/tvEmpty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/no_more_profiles"
        android:textAppearance="@style/Widget.Arelove.Subtitle"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>