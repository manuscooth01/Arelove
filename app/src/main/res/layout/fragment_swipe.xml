<?xml version="1.0" encoding="utf-8"?>
<!--
    Fragment de descubrimiento (swipe) - Rediseño Bloque 2.
    Card apilada, header con logo, barras tipo stories, chips de intereses.
    SwipeRefreshLayout permite actualizar los perfiles deslizando hacia abajo.
-->
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/swipeRefresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_canvas_gradient">

    <!-- Header con logo -->
    <LinearLayout
        android:id="@+id/llHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/logo_arelove"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:contentDescription="@string/app_name" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/app_name"
            android:textSize="22sp"
            android:letterSpacing="0.05"
            android:textColor="@color/primary"
            android:fontFamily="@font/poppins_bold" />

        <!-- Balance de diamantes -->
        <LinearLayout
            android:id="@+id/llDiamondBalance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_gravity="end"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:background="@drawable/bg_chip_looking">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_diamond"
                android:contentDescription="@string/diamonds_balance" />

            <TextView
                android:id="@+id/tvDiamondBalance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="0"
                android:textColor="@color/on_primary_container"
                android:textSize="14sp"
                android:fontFamily="@font/poppins_semibold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Card siguiente (apilada detrás) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardNext"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="18dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="18dp"
        app:cardCornerRadius="28dp"
        app:cardElevation="0dp"
        android:alpha="0.6"
        android:scaleX="0.95"
        android:scaleY="0.95"
        android:translationY="8dp"
        android:visibility="gone"
        android:background="@color/surface_container_high"
        app:layout_constraintTop_toBottomOf="@id/llHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/llActions"
        app:layout_constraintVertical_bias="0" />

    <!-- Card principal -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardProfile"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        app:cardCornerRadius="28dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/crimson_rim"
        app:strokeWidth="1dp"
        app:rippleColor="@color/primary"
        android:background="@drawable/bg_card_rim"
        app:layout_constraintTop_toBottomOf="@id/llHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/llActions"
        app:layout_constraintVertical_bias="0">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="false"
            android:focusable="false">

            <!-- Foto -->
            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/photoPager"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Scrim superior: legibilidad de las barras de fotos sobre la imagen -->
            <View
                android:id="@+id/vTopScrim"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_gravity="top"
                android:background="@drawable/bg_profile_gradient_top"
                android:clickable="false"
                android:focusable="false" />

            <!-- Barras indicadoras tipo stories (reemplazan dots) -->
            <LinearLayout
                android:id="@+id/llStoryIndicators"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:weightSum="6"
                android:visibility="gone"
                android:clickable="false"
                android:focusable="false" />

            <!-- Gradiente + info al pie -->
            <LinearLayout
                android:id="@+id/llProfileInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:background="@drawable/bg_profile_gradient_bottom"
                android:orientation="vertical"
                android:padding="20dp"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- Nombre + check: el bloque es wrap_content para que
                         el check quede inmediatamente a la derecha del
                         texto (si tvName pesara 1, el check se iría al
                         borde derecho de la card) -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_semibold"
                            android:textColor="@android:color/white"
                            android:textSize="26sp"
                            tools:text="María, 25" />

                        <ImageView
                            android:id="@+id/ivVerified"
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:layout_marginStart="8dp"
                            android:contentDescription="@string/profile_verified"
                            android:src="@drawable/ic_verified"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvLocation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:alpha="0.9"
                    tools:text="Caracas, Venezuela" />

                <TextView
                    android:id="@+id/tvLookingFor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_chip_looking"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:textColor="@color/on_primary_container"
                    android:textSize="12sp" />

                <LinearLayout
                    android:id="@+id/llGender"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_chip_looking"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/ivGenderIcon"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginEnd="6dp"
                        android:contentDescription="@string/field_gender" />

                    <TextView
                        android:id="@+id/tvGender"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/on_primary_container"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvBio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:alpha="0.85"
                    tools:text="Me gusta la música, viajar y comer rico" />

                <!-- ChipGroup de intereses -->
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupInterests"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    app:singleLine="false"
                    app:chipSpacing="8dp"
                    app:chipSpacingHorizontal="8dp"
                    app:chipSpacingVertical="8dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvOptionalDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    android:alpha="0.7"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:visibility="gone"
                    tools:text="168 cm · Virgo · Diseñador" />
            </LinearLayout>
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Botones de acción -->
    <LinearLayout
        android:id="@+id/llActions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="24dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/cardProfile"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Botón rewind (deshacer) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRewind"
            style="@style/Widget.Material3.Button"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginEnd="20dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:backgroundTint="@color/surface_variant"
            app:cornerRadius="40dp"
            app:elevation="2dp"
            app:icon="@drawable/ic_rewind"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="32dp"
            app:iconTint="@color/on_surface_variant"
            app:rippleColor="?attr/colorPrimary"
            android:stateListAnimator="@null"
            app:strokeWidth="0dp"
            android:visibility="gone" />

        <!-- Botón dislike -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDislike"
            style="@style/Widget.Material3.Button"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginEnd="28dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:backgroundTint="@color/surface_variant"
            app:cornerRadius="40dp"
            app:elevation="2dp"
            app:icon="@drawable/ic_dislike"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="36dp"
            app:iconTint="@color/on_surface_variant"
            app:rippleColor="?attr/colorPrimary"
            android:stateListAnimator="@null"
            app:strokeWidth="0dp" />

        <!-- Botón like -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLike"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:background="@drawable/bg_like_button_gradient"
            app:backgroundTint="@null"
            app:cornerRadius="40dp"
            app:elevation="8dp"
            app:icon="@drawable/ic_like"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="36dp"
            app:iconTint="@android:color/white"
            app:rippleColor="@android:color/white"
            android:stateListAnimator="@null"
            app:strokeWidth="0dp" />
    </LinearLayout>

    <!-- ProgressBar para "cargando más" (paginación infinita) -->
    <ProgressBar
        android:id="@+id/progressCargandoMas"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/llActions"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginBottom="8dp" />

    <!-- ProgressBar de carga -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="120dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Estado vacío -->
    <LinearLayout
        android:id="@+id/llEmpty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:background="@android:color/transparent"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ivEmptyIllustration"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_empty_swipe"
            android:contentDescription="@string/no_more_profiles" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/poppins_semibold"
            android:textSize="16sp"
            android:text="@string/no_more_profiles_title"
            android:gravity="center" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="14sp"
            android:text="@string/no_more_profiles_subtitle"
            android:gravity="center" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>