<?xml version="1.0" encoding="utf-8"?>
<!--
    Fragment de descubrimiento (swipe).
    Tarjeta principal con fotos, gradiente al pie, y botones like/nope centrados.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Card principal -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardProfile"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/llActions"
        app:layout_constraintVertical_bias="0">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Foto -->
            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/photoPager"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Indicador de páginas arriba centrado -->
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/photoIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="12dp"
                android:background="@android:color/transparent"
                app:tabBackground="@drawable/selector_photo_indicator"
                app:tabGravity="center"
                app:tabIndicatorHeight="0dp"
                app:tabMaxWidth="8dp"
                app:tabMinWidth="8dp"
                app:tabPaddingEnd="4dp"
                app:tabPaddingStart="4dp" />

            <!-- Gradiente + info al pie -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:background="@drawable/bg_profile_gradient_bottom"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/poppins_semibold"
                        android:textColor="@android:color/white"
                        android:textSize="22sp"
                        tools:text="María, 25" />

                    <ImageView
                        android:id="@+id/ivVerified"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="6dp"
                        android:contentDescription="@string/profile_verified"
                        android:src="@drawable/ic_verified"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvLocation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:alpha="0.9"
                    tools:text="Caracas, Venezuela" />

                <TextView
                    android:id="@+id/tvBio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:maxLines="3"
                    android:ellipsize="end"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:alpha="0.85"
                    tools:text="Me gusta la música, viajar y comer rico" />
            </LinearLayout>
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Botones de acción -->
    <LinearLayout
        android:id="@+id/llActions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="24dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/cardProfile"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Botón dislike -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDislike"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginEnd="24dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:cornerRadius="36dp"
            app:icon="@drawable/ic_dislike"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="32dp"
            app:iconTint="@color/primary"
            app:strokeColor="@color/primary"
            app:strokeWidth="2dp" />

        <!-- Botón like -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLike"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:backgroundTint="@color/primary"
            app:cornerRadius="36dp"
            app:icon="@drawable/ic_like"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="36dp"
            app:iconTint="@android:color/white" />
    </LinearLayout>

    <!-- ProgressBar de carga -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Estado vacío -->
    <TextView
        android:id="@+id/tvEmpty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/no_more_profiles"
        android:textAppearance="@style/Widget.Arelove.Subtitle"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>