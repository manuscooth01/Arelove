<?xml version="1.0" encoding="utf-8"?>
<!--
    Pantalla de Perfil - Rediseño.
    Header con avatar, badge verificación, género con ícono.
    Secciones: Tu cuenta (editar, intereses, fotos, verificación),
    Ayuda y legal (términos, privacidad, comunidad, FAQ),
    Descubre más (invitar, ajustes).
    Fondo siempre oscuro: colores profile_on_dark* fijos en ambos modos.
    Cards con estilo Widget.Arelove.Card (borde 1dp) y wrap_content para
    que no recorten con fuente grande.
-->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_canvas_gradient"
    android:fillViewport="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Header del perfil -->
    <LinearLayout
        android:id="@+id/profileHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="24dp"
        android:paddingBottom="16dp">

        <!-- Avatar 120dp con borde rojo 2dp y badge verificación -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="120dp"
            android:layout_height="120dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivAvatar"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:background="@color/primary"
                android:contentDescription="@string/profile_title"
                android:scaleType="centerCrop"
                android:strokeWidth="2"
                android:strokeColor="@color/primary"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Arelove.Avatar" />

            <TextView
                android:id="@+id/tvAvatarInitial"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:textColor="@android:color/white"
                android:textSize="48sp"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Badge de verificación (esquina inferior derecha) -->
            <ImageView
                android:id="@+id/ivVerifiedBadge"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="2dp"
                android:layout_marginBottom="2dp"
                android:contentDescription="@string/profile_verified"
                android:src="@drawable/ic_verified"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="16dp" />

        <!-- Nombre + badge verificado en línea horizontal -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_semibold"
                android:text="@string/nav_profile"
                android:textAppearance="@style/Widget.Arelove.Title"
                android:textColor="@color/profile_on_dark"
                android:textSize="24sp"
                tools:text="María García" />

            <!-- Badge verificado verde al lado del nombre -->
            <ImageView
                android:id="@+id/ivNameVerified"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/profile_verified"
                android:src="@drawable/ic_verified"
                android:visibility="gone"
                android:tint="@color/online_green" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvEmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="@style/Widget.Arelove.Subtitle"
            android:textColor="@color/profile_on_dark_muted"
            tools:text="maria@ejemplo.com" />

        <!-- Chip género con ícono al lado del email -->
        <LinearLayout
            android:id="@+id/llGender"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">

            <ImageView
                android:id="@+id/ivGenderIcon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="6dp"
                android:contentDescription="@string/field_gender" />

            <TextView
                android:id="@+id/tvGender"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_looking"
                android:fontFamily="@font/poppins_medium"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:textColor="@color/on_primary_container"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- SECCIÓN 1: Tu cuenta -->
    <TextView
        android:id="@+id/tvSectionAccount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:fontFamily="@font/poppins_semibold"
        android:text="@string/profile_section_account"
        android:textAllCaps="true"
        android:textColor="@color/profile_on_dark_muted"
        android:textSize="13sp"
        android:letterSpacing="0.05" />

    <!-- Card Editar perfil -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardEditProfile"
        style="@style/Widget.Arelove.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="16dp"
        android:minHeight="64dp"
        app:cardBackgroundColor="@color/profile_option_bg"
        app:contentPaddingStart="16dp"
        app:contentPaddingTop="14dp"
        app:contentPaddingEnd="16dp"
        app:contentPaddingBottom="14dp"
        app:strokeColor="@color/profile_option_stroke"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="16dp"
                android:src="@drawable/ic_edit"
                android:tint="@color/profile_on_dark_muted" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/poppins_medium"
                android:text="@string/edit_profile"
                android:textColor="@color/profile_on_dark"
                android:textSize="15sp" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_chevron_right"
                android:tint="@color/profile_on_dark_muted" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Card Mis intereses -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardInterests"
        style="@style/Widget.Arelove.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="16dp"
        android:minHeight="64dp"
        app:cardBackgroundColor="@color/profile_option_bg"
        app:contentPaddingStart="16dp"
        app:contentPaddingTop="14dp"
        app:contentPaddingEnd="16dp"
        app:contentPaddingBottom="14dp"
        app:strokeColor="@color/profile_option_stroke"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="16dp"
                android:src="@drawable/ic_favorite"
                android:tint="@color/profile_on_dark_muted" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/poppins_medium"
                android:text="@string/profile_interests"
                android:textColor="@color/profile_on_dark"
                android:textSize="15sp" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_chevron_right"
                android:tint="@color/profile_on_dark_muted" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Card Cambiar fotos -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardChangePhotos"
        style="@style/Widget.Arelove.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="16dp"
        android:minHeight="64dp"
        app:cardBackgroundColor="@color/profile_option_bg"
        app:contentPaddingStart="16dp"
        app:contentPaddingTop="14dp"
        app:contentPaddingEnd="16dp"
        app:contentPaddingBottom="14dp"
        app:strokeColor="@color/profile_option_stroke"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="16dp"
                android:src="@drawable/ic_camera"
                android:tint="@color/profile_on_dark_muted" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/poppins_medium"
                android:text="@string/change_photos"
                android:textColor="@color/profile_on_dark"
                android:textSize="15sp" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_chevron_right"
                android:tint="@color/profile_on_dark_muted" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Card Verificación con estado dinámico -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardVerification"
        style="@style/Widget.Arelove.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="16dp"
        android:minHeight="64dp"
        app:cardBackgroundColor="@color/profile_option_bg"
        app:contentPaddingStart="16dp"
        app:contentPaddingTop="14dp"
        app:contentPaddingEnd="16dp"
        app:contentPaddingBottom="14dp"
        app:strokeColor="@color/profile_option_stroke"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="16dp"
                    android:src="@drawable/ic_shield"
                    android:tint="@color/profile_on_dark_muted" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/poppins_medium"
                    android:text="@string/verification"
                    android:textColor="@color/profile_on_dark"
                    android:textSize="15sp" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_chevron_right"
                    android:tint="@color/profile_on_dark_muted" />
            </LinearLayout>

            <!-- Estado: Verificado / En revisión / Sin verificar -->
            <TextView
                android:id="@+id/tvVerificationStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="40dp"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/poppins_medium"
                android:textColor="@color/profile_on_dark_muted"
                android:textSize="13sp"
                android:visibility="gone"
                tools:text="Sin verificar" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- SECCIÓN 2: Ayuda y legal -->
    <TextView
        android:id="@+id/tvSectionSecurity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="16dp"
        android:fontFamily="@font/poppins_semibold"
        android:text="@string/profile_section_help"
        android:textAllCaps="true"
        android:textColor="@color/profile_on_dark_muted"
        android:textSize="13sp"
        android:letterSpacing="0.05" />

    <!-- Card Términos y condiciones -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardTerms"
        style="@style/Widget.Arelove.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="16dp"
        android:minHeight="64dp"
        app:cardBackgroundColor="@color/profile_option_bg"
        app:contentPaddingStart="16dp"
        app:contentPaddingTop="14dp"
        app:contentPaddingEnd="16dp"
        app:contentPaddingBottom="14dp"
        app:strokeColor="@color/profile_option_stroke"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="16dp"
                android:src="@drawable/ic_info"
                android:tint="@color/profile_on_dark_muted" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/poppins_medium"
                android:text="@string/profile_terms"
                android:textColor="@color/profile_on_dark"
                android:textSize="15sp" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_chevron_right"
                android:tint="@color/profile_on_dark_muted" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Card Política de privacidad -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardPrivacy"
        style="@style/Widget.Arelove.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="16dp"
        android:minHeight="64dp"
        app:cardBackgroundColor="@color/profile_option_bg"
        app:contentPaddingStart="16dp"
        app:contentPaddingTop="14dp"
        app:contentPaddingEnd="16dp"
        app:contentPaddingBottom="14dp"
        app:strokeColor="@color/profile_option_stroke"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="16dp"
                android:src="@drawable/ic_lock"
                android:tint="@color/profile_on_dark_muted" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/poppins_medium"
                android:text="@string/legal_privacidad_title"
                android:textColor="@color/profile_on_dark"
                android:textSize="15sp" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_chevron_right"
                android:tint="@color/profile_on_dark_muted" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Card Reglas de la comunidad -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardCommunity"
        style="@style/Widget.Arelove.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="16dp"
        android:minHeight="64dp"
        app:cardBackgroundColor="@color/profile_option_bg"
        app:contentPaddingStart="16dp"
        app:contentPaddingTop="14dp"
        app:contentPaddingEnd="16dp"
        app:contentPaddingBottom="14dp"
        app:strokeColor="@color/profile_option_stroke"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="16dp"
                android:src="@drawable/ic_group"
                android:tint="@color/profile_on_dark_muted" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/poppins_medium"
                android:text="@string/legal_comunidad_title"
                android:textColor="@color/profile_on_dark"
                android:textSize="15sp" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_chevron_right"
                android:tint="@color/profile_on_dark_muted" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Card Preguntas frecuentes -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardFaq"
        style="@style/Widget.Arelove.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="16dp"
        android:minHeight="64dp"
        app:cardBackgroundColor="@color/profile_option_bg"
        app:contentPaddingStart="16dp"
        app:contentPaddingTop="14dp"
        app:contentPaddingEnd="16dp"
        app:contentPaddingBottom="14dp"
        app:strokeColor="@color/profile_option_stroke"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="16dp"
                android:src="@drawable/ic_help"
                android:tint="@color/profile_on_dark_muted" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/poppins_medium"
                android:text="@string/profile_faq"
                android:textColor="@color/profile_on_dark"
                android:textSize="15sp" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_chevron_right"
                android:tint="@color/profile_on_dark_muted" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- SECCIÓN 3: Descubre más -->
    <TextView
        android:id="@+id/tvSectionMore"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="16dp"
        android:fontFamily="@font/poppins_semibold"
        android:text="@string/profile_section_more"
        android:textAllCaps="true"
        android:textColor="@color/profile_on_dark_muted"
        android:textSize="13sp"
        android:letterSpacing="0.05" />

    <!-- Card Invitar amigos -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardInvite"
        style="@style/Widget.Arelove.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="16dp"
        android:minHeight="64dp"
        app:cardBackgroundColor="@color/profile_option_bg"
        app:contentPaddingStart="16dp"
        app:contentPaddingTop="14dp"
        app:contentPaddingEnd="16dp"
        app:contentPaddingBottom="14dp"
        app:strokeColor="@color/profile_option_stroke"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="16dp"
                android:src="@drawable/ic_share"
                android:tint="@color/profile_on_dark_muted" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/poppins_medium"
                android:text="@string/profile_invite"
                android:textColor="@color/profile_on_dark"
                android:textSize="15sp" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_chevron_right"
                android:tint="@color/profile_on_dark_muted" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Card Ajustes -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardSettings"
        style="@style/Widget.Arelove.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="16dp"
        android:minHeight="64dp"
        app:cardBackgroundColor="@color/profile_option_bg"
        app:contentPaddingStart="16dp"
        app:contentPaddingTop="14dp"
        app:contentPaddingEnd="16dp"
        app:contentPaddingBottom="14dp"
        app:strokeColor="@color/profile_option_stroke"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="16dp"
                android:src="@drawable/ic_settings"
                android:tint="@color/profile_on_dark_muted" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/poppins_medium"
                android:text="@string/settings"
                android:textColor="@color/profile_on_dark"
                android:textSize="15sp" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_chevron_right"
                android:tint="@color/profile_on_dark_muted" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Botón cerrar sesión compacto, alineado a la izquierda -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLogout"
        style="@style/Widget.Arelove.Button.Outlined"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp"
        android:fontFamily="@font/poppins_semibold"
        android:text="@string/logout"
        android:textAllCaps="false"
        android:textColor="@color/primary"
