<?xml version="1.0" encoding="utf-8"?>
<!--
    Pantalla de Perfil - Rediseño.
    Header con avatar (borde rojo + sombra), nombre en bold, chips de género
    y verificado. Banner de completitud del perfil.
    Secciones: Tu cuenta (editar + fotos), Seguridad y privacidad
    (verificación + ajustes), Ayuda y legal (términos, privacidad,
    comunidad, FAQ) y Descubre más (invitar + panel admin, este solo
    visible para profiles.is_admin = true).
    Tarjetas con estilo Widget.Arelove.ProfileCard: fondo con degradado
    fijo oscuro, esquinas 16dp, disco de 32dp con el icono y chevrón.
    Altura compacta: minHeight 56dp, icono 32dp, título 15sp y subtítulo
    12sp (para diferenciar las opciones que se parecen entre sí).
    Fondo siempre oscuro: colores profile_on_dark* fijos en ambos modos.
-->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_canvas_gradient"
    android:fillViewport="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="8dp">

    <!-- Header del perfil -->
    <LinearLayout
        android:id="@+id/profileHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="24dp"
        android:paddingBottom="16dp">

        <!-- Avatar 120dp con borde rojo 2dp, sombra y badge verificación.
             El contenedor es 132dp para dejar 6dp libres a la sombra. -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="132dp"
            android:layout_height="132dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivAvatar"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:background="@drawable/bg_avatar_circle"
                android:contentDescription="@string/profile_title"
                android:elevation="6dp"
                android:scaleType="centerCrop"
                android:strokeWidth="2"
                android:strokeColor="@color/primary"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Arelove.Avatar" />

            <TextView
                android:id="@+id/tvAvatarInitial"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:textColor="@android:color/white"
                android:textSize="48sp"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="@id/ivAvatar"
                app:layout_constraintEnd_toEndOf="@id/ivAvatar"
                app:layout_constraintStart_toStartOf="@id/ivAvatar"
                app:layout_constraintTop_toTopOf="@id/ivAvatar" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Nombre + check de verificación, centrados en pantalla
             (el Space de 16dp pasa a layout_marginTop del bloque) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:text="@string/nav_profile"
                android:textColor="@color/profile_on_dark"
                android:textSize="26sp"
                tools:text="Manuel" />

            <ImageView
                android:id="@+id/ivVerifiedName"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/profile_verified"
                android:src="@drawable/ic_verified"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvEmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="@style/Widget.Arelove.Subtitle"
            android:textColor="@color/profile_on_dark_muted"
            tools:text="maria@ejemplo.com" />

        <!-- Chips de género y verificado (solo visibles si hay dato) -->
        <LinearLayout
            android:id="@+id/llHeaderChips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/llGender"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/ivGenderIcon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="6dp"
                    android:contentDescription="@string/field_gender" />

                <TextView
                    android:id="@+id/tvGender"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_looking"
                    android:fontFamily="@font/poppins_medium"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:textColor="@color/on_primary_container"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Chip "Verificado" al lado del género -->
            <LinearLayout
                android:id="@+id/llVerifiedChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_chip_verified"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/ivVerifiedChip"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="6dp"
                    android:contentDescription="@string/profile_badge_verified"
                    android:src="@drawable/ic_verified"
                    android:tint="@color/online_green" />

                <TextView
                    android:id="@+id/tvVerifiedChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_medium"
                    android:text="@string/profile_badge_verified"
                    android:textColor="@color/online_green"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Banner de completitud del perfil (se pinta al cargar los datos) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardCompletion"
        style="@style/Widget.Arelove.ProfileCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:visibility="gone"
        tools:visibility="visible">

        <!-- Padding dentro del contenedor: 20dp laterales + 16dp verticales -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="72dp"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/tvProfileCompletion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_semibold"
                android:textColor="@color/profile_on_dark"
                android:textSize="15sp"
                tools:text="Tu perfil está al 69%" />

            <!-- Barra fina (6dp) con 12dp de aire bajo el texto -->
            <ProgressBar
                android:id="@+id/progressProfileCompletion"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="12dp"
                android:max="100"
                android:progress="0"
                android:progressBackgroundTint="@color/profile_option_stroke"
                android:progressTint="@color/primary" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- SECCIÓN 1: Tu cuenta (barrita roja + título) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:layout_width="4dp"
            android:layout_height="14dp"
            android:background="@drawable/bg_section_bar" />

        <TextView
            android:id="@+id/tvSectionAccount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFamily="@font/poppins_semibold"
            android:text="@string/profile_section_account"
            android:textAllCaps="true"
            android:textColor="@color/profile_on_dark"
            android:textSize="13sp"
            android:letterSpacing="0.05" />
    </LinearLayout>

    <!-- Card Editar perfil (abre la pantalla de edición) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardEditProfile"
        style="@style/Widget.Arelove.ProfileCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        app:contentPaddingStart="16dp"
        app:contentPaddingEnd="16dp"
        app:contentPaddingTop="12dp"
        app:contentPaddingBottom="12dp"
        app:rippleColor="@color/on_primary">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="40dp"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_icon_circle"
                android:backgroundTint="@color/primary">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_edit"
                    android:tint="@color/primary" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_marginStart="16dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_medium"
                    android:text="@string/edit_profile"
                    android:textColor="@color/profile_on_dark"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/profile_sub_edit_profile"
                    android:textColor="@color/profile_on_dark_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center_vertical"
                android:alpha="0.6"
                android:src="@drawable/ic_chevron_right"
                android:tint="@color/profile_on_dark_muted" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Card Mis fotos (abre el asistente en el paso de fotos) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardMyPhotos"
        style="@style/Widget.Arelove.ProfileCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        app:contentPaddingStart="16dp"
        app:contentPaddingEnd="16dp"
        app:contentPaddingTop="12dp"
        app:contentPaddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="40dp"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_icon_circle"
                android:backgroundTint="@color/secondary_coral">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_gallery"
                    android:tint="@color/secondary_coral" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_marginStart="16dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_medium"
                    android:text="@string/my_photos"
                    android:textColor="@color/profile_on_dark"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/profile_sub_my_photos"
                    android:textColor="@color/profile_on_dark_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center_vertical"
                android:alpha="0.6"
                android:src="@drawable/ic_chevron_right"
                android:tint="@color/profile_on_dark_muted" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- SECCIÓN 2: Seguridad y privacidad -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:layout_width="4dp"
            android:layout_height="14dp"
            android:background="@drawable/bg_section_bar" />

        <TextView
            android:id="@+id/tvSectionSecurity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFamily="@font/poppins_semibold"
            android:text="@string/profile_section_security"
            android:textAllCaps="true"
            android:textColor="@color/profile_on_dark"
            android:textSize="13sp"
            android:letterSpacing="0.05" />
    </LinearLayout>

    <!-- Card Verificación: el subtítulo es el estado dinámico -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardVerification"
        style="@style/Widget.Arelove.ProfileCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        app:contentPaddingStart="16dp"
        app:contentPaddingEnd="16dp"
        app:contentPaddingTop="12dp"
        app:contentPaddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="40dp"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_icon_circle"
                android:backgroundTint="@color/online_green">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_shield"
                    android:tint="@color/online_green" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_medium"
                    android:text="@string/verification"
                    android:textColor="@color/profile_on_dark"
                    android:textSize="15sp" />

                <!-- Estado: Verificado / En revisión / Sin verificar -->
                <TextView
                    android:id="@+id/tvVerificationStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/poppins_medium"
                    android:textColor="@color/profile_on_dark_muted"
                    android:textSize="12sp"
                    android:visibility="gone"
                    tools:text="Selfie en revisión" />
            </LinearLayout>

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center_vertical"
                android:alpha="0.6"
                android:src="@drawable/ic_chevron_right"
                android:tint="@color/profile_on_dark_muted" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Card Ajustes (movida aquí desde Descubre más) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardSettings"
        style="@style/Widget.Arelove.ProfileCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        app:contentPaddingStart="16dp"
        app:contentPaddingEnd="16dp"
        app:contentPaddingTop="12dp"
        app:contentPaddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="40dp"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_icon_circle"
                android:backgroundTint="@color/profile_on_dark_muted">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_settings"
                    android:tint="@color/profile_on_dark_muted" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_marginStart="16dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_medium"
                    android:text="@string/settings"
                    android:textColor="@color/profile_on_dark"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/profile_sub_settings"
                    android:textColor="@color/profile_on_dark_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center_vertical"
                android:alpha="0.6"
                android:src="@drawable/ic_chevron_right"
                android:tint="@color/profile_on_dark_muted" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- SECCIÓN 3: Ayuda y legal -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:layout_width="4dp"
            android:layout_height="14dp"
            android:background="@drawable/bg_section_bar" />

        <TextView
            android:id="@+id/tvSectionLegal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFamily="@font/poppins_semibold"
            android:text="@string/profile_section_help"
            android:textAllCaps="true"
            android:textColor="@color/profile_on_dark"
            android:textSize="13sp"
            android:letterSpacing="0.05" />
    </LinearLayout>

    <!-- Card Términos y condiciones -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardTerms"
        style="@style/Widget.Arelove.ProfileCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        app:contentPaddingStart="16dp"
        app:contentPaddingEnd="16dp"
        app:contentPaddingTop="12dp"
        app:contentPaddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="40dp"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_icon_circle"
                android:backgroundTint="@color/profile_on_dark_muted">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_info"
                    android:tint="@color/profile_on_dark_muted" />
            </FrameLayout>

            <TextView
                android:layout_width="0dp"
                android:layout_marginStart="16dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/poppins_medium"
                android:text="@string/profile_terms"
                android:textColor="@color/profile_on_dark"
                android:textSize="15sp" />

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center_vertical"
                android:alpha="0.6"
                android:src="@drawable/ic_chevron_right"
                android:tint="@color/profile_on_dark_muted" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Card Política de privacidad -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardPrivacy"
        style="@style/Widget.Arelove.ProfileCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        app:contentPaddingStart="16dp"
        app:contentPaddingEnd="16dp"
        app:contentPaddingTop="12dp"
        app:contentPaddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="40dp"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_icon_circle"
                android:backgroundTint="@color/profile_on_dark_muted">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_lock"
                    android:tint="@color/profile_on_dark_muted" />
            </FrameLayout>

            <TextView
                android:layout_width="0dp"
                android:layout_marginStart="16dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/poppins_medium"
                android:text="@string/legal_privacidad_title"
                android:textColor="@color/profile_on_dark"
                android:textSize="15sp" />

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center_vertical"
                android:alpha="0.6"
                android:src="@drawable/ic_chevron_right"
                android:tint="@color/profile_on_dark_muted" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Card Reglas de la comunidad -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardCommunity"
        style="@style/Widget.Arelove.ProfileCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        app:contentPaddingStart="16dp"
        app:contentPaddingEnd="16dp"
        app:contentPaddingTop="12dp"
        app:contentPaddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="40dp"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_icon_circle"
                android:backgroundTint="@color/profile_on_dark_muted">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_group"
                    android:tint="@color/profile_on_dark_muted" />
            </FrameLayout>

            <TextView
                android:layout_width="0dp"
                android:layout_marginStart="16dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/poppins_medium"
                android:text="@string/legal_comunidad_title"
                android:textColor="@color/profile_on_dark"
                android:textSize="15sp" />

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center_vertical"
                android:alpha="0.6"
                android:src="@drawable/ic_chevron_right"
                android:tint="@color/profile_on_dark_muted" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Card Preguntas frecuentes -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardFaq"
        style="@style/Widget.Arelove.ProfileCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        app:contentPaddingStart="16dp"
        app:contentPaddingEnd="16dp"
        app:contentPaddingTop="12dp"
        app:contentPaddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="40dp"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_icon_circle"
                android:backgroundTint="@color/profile_on_dark_muted">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_help"
                    android:tint="@color/profile_on_dark_muted" />
            </FrameLayout>

            <TextView
                android:layout_width="0dp"
                android:layout_marginStart="16dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/poppins_medium"
                android:text="@string/profile_faq"
                android:textColor="@color/profile_on_dark"
                android:textSize="15sp" />

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center_vertical"
                android:alpha="0.6"
                android:src="@drawable/ic_chevron_right"
                android:tint="@color/profile_on_dark_muted" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- SECCIÓN 4: Descubre más -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:layout_width="4dp"
            android:layout_height="14dp"
            android:background="@drawable/bg_section_bar" />

        <TextView
            android:id="@+id/tvSectionMore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFamily="@font/poppins_semibold"
            android:text="@string/profile_section_more"
            android:textAllCaps="true"
            android:textColor="@color/profile_on_dark"
            android:textSize="13sp"
            android:letterSpacing="0.05" />
    </LinearLayout>

    <!-- Card Invitar amigos -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardInvite"
        style="@style/Widget.Arelove.ProfileCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        app:contentPaddingStart="16dp"
        app:contentPaddingEnd="16dp"
        app:contentPaddingTop="12dp"
        app:contentPaddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="40dp"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_icon_circle"
                android:backgroundTint="@color/profile_on_dark_muted">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_share"
                    android:tint="@color/profile_on_dark_muted" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_marginStart="16dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_medium"
                    android:text="@string/profile_invite"
                    android:textColor="@color/profile_on_dark"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/profile_sub_invite"
                    android:textColor="@color/profile_on_dark_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center_vertical"
                android:alpha="0.6"
                android:src="@drawable/ic_chevron_right"
                android:tint="@color/profile_on_dark_muted" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Card Panel de administración: solo visible si profiles.is_admin = true
         (AdminChecker). Borde y título en rojo de marca para distinguirla. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardAdmin"
        style="@style/Widget.Arelove.ProfileCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:visibility="gone"
        app:contentPaddingStart="16dp"
        app:contentPaddingEnd="16dp"
        app:contentPaddingTop="12dp"
        app:contentPaddingBottom="12dp"
        app:strokeColor="@color/primary"
        app:strokeWidth="1dp"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="40dp"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_icon_circle"
                android:backgroundTint="@color/primary">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_trending_up"
                    android:tint="@color/primary" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_marginStart="16dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_medium"
                    android:text="@string/profile_admin_panel"
                    android:textColor="@color/primary"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/profile_sub_admin"
                    android:textColor="@color/profile_on_dark_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center_vertical"
                android:alpha="0.6"
                android:src="@drawable/ic_chevron_right"
                android:tint="@color/profile_on_dark_muted" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Botón cerrar sesión a ancho completo, alineado con las cards -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLogout"
        style="@style/Widget.Arelove.Button.Outlined"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="32dp"
        android:fontFamily="@font/poppins_semibold"
        android:text="@string/logout"
        android:textAllCaps="false"
        android:textColor="@color/primary"
        app:strokeColor="@color/primary"
        app:strokeWidth="1.5dp" />

</LinearLayout>
</ScrollView>
