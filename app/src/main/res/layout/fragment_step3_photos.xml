<?xml version="1.0" encoding="utf-8"?>
<!--
    Paso 3 del asistente de perfil: galería de fotos (mínimo 2, máximo 6).
    Sin background en la raíz: el fondo lo pinta el tema (evita overdraw).
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <!-- Título -->
        <TextView
            android:id="@+id/tvPhotosTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:text="@string/profile_step3_title"
            android:textColor="@color/on_surface"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Subtítulo -->
        <TextView
            android:id="@+id/tvPhotosSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif"
            android:text="@string/profile_step3_subtitle"
            android:textColor="@color/on_surface_variant"
            android:textSize="14sp" />

        <!-- Contador "0 de 2 mínimo" / "3 fotos" -->
        <TextView
            android:id="@+id/tvPhotoCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif"
            android:textColor="@color/on_surface_variant"
            android:textSize="14sp"
            tools:text="0 de 2 mínimo" />

        <!-- Rejilla de 2 columnas con las fotos y la celda "+" -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvPhotos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            tools:listitem="@layout/item_photo" />

        <!-- Error en línea (mínimo de fotos no alcanzado) -->
        <TextView
            android:id="@+id/tvPhotosError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif"
            android:textColor="@color/error"
            android:textSize="14sp"
            android:visibility="gone"
            tools:text="@string/profile_step3_error_min"
            tools:visibility="visible" />

        <!-- Spinner de carga (al cargar y mientras sube una foto) -->
        <ProgressBar
            android:id="@+id/progressBarPhotos"
            style="?android:attr/progressBarStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            tools:visibility="visible" />

    </LinearLayout>

</ScrollView>
