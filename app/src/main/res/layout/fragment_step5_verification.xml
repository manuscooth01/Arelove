<?xml version="1.0" encoding="utf-8"?>
<!--
    Paso 5 (último) del asistente de perfil: selfie de verificación.
    La selfie se sube al bucket "verification" y solo se guarda su URL en
    profiles; la columna "verified" la pone el equipo de Arelove.
    Sin background en la raíz: el fondo lo pinta el tema (evita overdraw).
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <!-- Título -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_semibold"
            android:text="@string/profile_step5_title"
            android:textAppearance="@style/Widget.Arelove.Title" />

        <!-- Subtítulo -->
        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/profile_step5_subtitle"
            android:textAppearance="@style/Widget.Arelove.Subtitle" />

        <!-- Tarjeta explicativa -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/ivIconVerified"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_verified" />

                <TextView
                    android:id="@+id/tvExplanation"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="@string/profile_step5_explanation"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="14sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Preview de la selfie (visible solo tras subirla) -->
        <ImageView
            android:id="@+id/ivSelfiePreview"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="16dp"
            android:background="@color/photo_placeholder"
            android:contentDescription="@string/profile_step5_status_review"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- Estado de la verificación -->
        <TextView
            android:id="@+id/tvVerificationStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/poppins_semibold"
            android:text="@string/profile_step5_status_unverified"
            android:textColor="@color/on_surface_variant"
            android:textSize="14sp" />

        <!-- Botón rojo grande: tomar selfie con la cámara -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTakeSelfie"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:text="@string/profile_step5_take_selfie"
            android:textAllCaps="false"
            android:textSize="15sp"
            app:icon="@drawable/ic_camera"
            app:iconGravity="textStart"
            app:iconPadding="8dp" />

        <!-- Botón outlined: elegir una foto ya existente -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPickSelfie"
            style="@style/Widget.Arelove.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/profile_step5_pick_gallery"
            android:textAllCaps="false"
            android:textSize="15sp"
            app:icon="@drawable/ic_gallery"
            app:iconGravity="textStart"
            app:iconPadding="8dp" />

        <!-- Saltar la verificación (se oculta cuando ya hay selfie) -->
        <TextView
            android:id="@+id/btnSkip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:fontFamily="@font/poppins_semibold"
            android:padding="8dp"
            android:text="@string/profile_step5_skip"
            android:textColor="@color/on_surface_variant"
            android:textSize="14sp" />

        <!-- Carga (al subir la selfie) -->
        <ProgressBar
            android:id="@+id/progressBarVerification"
            style="?android:attr/progressBarStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            tools:visibility="visible" />

    </LinearLayout>
</ScrollView>
