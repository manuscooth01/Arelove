<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="20dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <!-- Título -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_semibold"
            android:text="@string/profile_step1_title"
            android:textAppearance="@style/Widget.Arelove.Title" />

        <!-- Subtítulo -->
        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/profile_step1_subtitle"
            android:textAppearance="@style/Widget.Arelove.Subtitle" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="24dp" />

        <!-- Apodo -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilNickname"
            style="@style/Widget.Arelove.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/field_nickname">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etNickname"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPersonName|textCapWords"
                android:maxLines="1"
                android:textSize="15sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Fecha de nacimiento (selector con MaterialDatePicker) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilBirthdate"
            style="@style/Widget.Arelove.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/field_birthdate"
            app:endIconDrawable="@drawable/ic_calendar"
            app:endIconMode="custom">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etBirthdate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="false"
                android:inputType="none"
                android:maxLines="1"
                android:textSize="15sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Ciudad / estado (con sugerencias de ciudades de Venezuela) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilLocation"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/field_place">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/etLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:completionThreshold="1"
                android:ellipsize="end"
                android:inputType="textPersonName|textCapWords"
                android:maxLines="1"
                android:singleLine="true"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textSize="15sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Botón: rellenar el lugar con la ubicación del GPS -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUseLocation"
            style="@style/Widget.Arelove.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/use_my_location"
            android:textAllCaps="false"
            android:textSize="14sp"
            app:icon="@drawable/ic_location"
            app:iconGravity="textStart"
            app:iconPadding="8dp" />

        <!-- Qué busco -->
        <TextView
            android:id="@+id/tvLookingFor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/poppins_semibold"
            android:text="@string/field_looking_for"
            android:textColor="@color/on_surface"
            android:textSize="15sp" />

        <LinearLayout
            android:id="@+id/llLookingFor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupLooking"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="8dp"
                app:chipSpacingVertical="8dp"
                app:selectionRequired="false"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipPareja"
                    style="@style/Widget.Arelove.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="@string/looking_pareja" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAmistades"
                    style="@style/Widget.Arelove.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="@string/looking_amistades" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAmbos"
                    style="@style/Widget.Arelove.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="@string/looking_ambos" />
            </com.google.android.material.chip.ChipGroup>
        </LinearLayout>

<!-- Error de la selección "Busco" -->
    <TextView
        android:id="@+id/tvLookingError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/error"
        android:textSize="13sp"
        android:visibility="gone"
        tools:text="Elige qué buscas" />

    <!-- Género -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="@font/poppins_semibold"
        android:text="@string/field_gender"
        android:textColor="@color/on_surface"
        android:textSize="15sp" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupGender"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:chipSpacingHorizontal="8dp"
        app:chipSpacingVertical="8dp"
        app:singleSelection="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipHombre"
            style="@style/Widget.Arelove.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checkable="true"
            android:text="@string/gender_hombre" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipMujer"
            style="@style/Widget.Arelove.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checkable="true"
            android:text="@string/gender_mujer" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipOtro"
            style="@style/Widget.Arelove.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checkable="true"
            android:text="@string/gender_otro" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipPrefieroNoDecir"
            style="@style/Widget.Arelove.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checkable="true"
            android:text="@string/gender_prefiero_no_decir" />
    </com.google.android.material.chip.ChipGroup>

    <!-- Error de género -->
    <TextView
        android:id="@+id/tvGenderError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/error"
        android:textSize="13sp"
        android:visibility="gone"
        tools:text="Elige tu género" />

</LinearLayout>
</ScrollView>
