<?xml version="1.0" encoding="utf-8"?>
<!--
    Panel admin: una verificación pendiente. Selfie (bucket verification)
    y primera foto de perfil (bucket avatars) lado a lado, nombre + edad y
    los botones Rechazar / Aprobar.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Arelove.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:contentPaddingStart="16dp"
    app:contentPaddingTop="16dp"
    app:contentPaddingEnd="16dp"
    app:contentPaddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Selfie y foto de perfil, 100dp cada una -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivSelfie"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:background="@color/photo_placeholder"
                android:contentDescription="@string/admin_selfie_desc"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_shield"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Arelove.Photo" />

            <Space
                android:layout_width="12dp"
                android:layout_height="match_parent" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivProfilePhoto"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:background="@color/photo_placeholder"
                android:contentDescription="@string/avatar"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_nav_profile"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Arelove.Photo" />
        </LinearLayout>

        <!-- Nombre + edad -->
        <TextView
            android:id="@+id/tvNameAge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:fontFamily="@font/poppins_semibold"
            android:maxLines="1"
            android:textColor="@color/on_surface"
            android:textSize="16sp" />

        <!-- Rechazar / Aprobar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRechazar"
                style="@style/Widget.Arelove.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="@string/admin_reject"
                android:textColor="@color/arelove_red"
                app:strokeColor="@color/arelove_red" />

            <Space
                android:layout_width="12dp"
                android:layout_height="match_parent" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAprobar"
                style="@style/Widget.Arelove.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                app:backgroundTint="@color/dialog_success"
                android:text="@string/admin_approve" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
